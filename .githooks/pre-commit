#!/bin/sh
set -eu

file='time_of_day_quotes_with_bold.json'

# Do not touch the file for commits that do not include it.
if ! git diff --cached --name-only --diff-filter=ACMR | grep -Fqx "$file"; then
  exit 0
fi

before=$(git hash-object -- "$file")
python3 scripts/format_time_of_day_quotes.py --file "$file" >/dev/null
after=$(git hash-object -- "$file")

if [ "$before" != "$after" ]; then
  echo "pre-commit: formatted $file"
fi

git add -- "$file"
